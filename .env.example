# QuickBank local defaults
# Copy to .env before `docker compose up`. None of these are production secrets.

MYSQL_DATABASE=quickbank
MYSQL_USER=quickbank
MYSQL_PASSWORD=quickbank
MYSQL_ROOT_PASSWORD=root

SERVER_PORT=8088
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/quickbank?characterEncoding=UTF-8&connectionTimeZone=UTC&forceConnectionTimeZoneToSession=true
SPRING_DATASOURCE_USERNAME=quickbank
SPRING_DATASOURCE_PASSWORD=quickbank
SPRING_KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Token iss is the browser-facing Keycloak URL. Inside Compose the app fetches
# keys and exchanges codes on http://keycloak:8080; docker-compose.yml overrides those.
QUICKBANK_ISSUER=http://localhost:8080/realms/quickbank
QUICKBANK_JWK_SET_URI=http://localhost:8080/realms/quickbank/protocol/openid-connect/certs
KEYCLOAK_CLIENT_ID=quickbank-web
KEYCLOAK_CLIENT_SECRET=quickbank-web-secret
KEYCLOAK_AUTHORIZATION_URI=http://localhost:8080/realms/quickbank/protocol/openid-connect/auth
KEYCLOAK_TOKEN_URI=http://localhost:8080/realms/quickbank/protocol/openid-connect/token
KEYCLOAK_USERINFO_URI=http://localhost:8080/realms/quickbank/protocol/openid-connect/userinfo
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# Leave the Dynatrace variables empty to export OTLP to the Compose collector and Jaeger.
# DT_OTLP_ENDPOINT is the base, for example https://{env-id}.live.dynatrace.com/api/v2/otlp
DT_TENANT=
DT_API_TOKEN=
DT_OTLP_ENDPOINT=
OTLP_TRACES_ENDPOINT=http://localhost:4318/v1/traces
OTLP_METRICS_ENDPOINT=http://localhost:4318/v1/metrics

QUICKBANK_CREDIT_LIMIT=2000.00
QUICKBANK_PAYMENT_MOCK_DELAY_MS=750
QUICKBANK_OUTBOX_DELAY_MS=250
QUICKBANK_OUTBOX_BATCH_SIZE=40

HIKARI_MAXIMUM_POOL_SIZE=10
HIKARI_MINIMUM_IDLE=2
HIKARI_CONNECTION_TIMEOUT=3000
HIKARI_IDLE_TIMEOUT=600000
HIKARI_MAX_LIFETIME=1800000
HIKARI_KEEPALIVE_TIME=300000
HIKARI_LEAK_DETECTION_THRESHOLD=20000
